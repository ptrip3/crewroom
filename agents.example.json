{
  "owner": "your-name",
  "default_room": "general",
  "notes_dir": "C:/Users/you/Documents/Notes",
  "project": {
    "name": "My Project",
    "dir": "C:/Projects/my-project",
    "rules_file": "RULES.md",
    "ready_check": "npm test"
  },
  "roots": [
    "C:/Projects/my-project/lead",
    "C:/Projects/my-project/qa"
  ],
  "listen_seconds": 3600,
  "max_wakeups": 20,
  "agents": {
    "lead":        { "aliases": ["orch"], "can_push": true, "branch": "main", "role": "Lead: splits work from the owner into tasks, answers agents, and asks the owner to approve pushes." },
    "qa":          { "aliases": ["qe"], "branch": "qa", "role": "Reviews every finished branch (get_skill review, security, verify) before it is merged." },
    "cursor":      { "aliases": ["ui"], "listen_seconds": 3600, "max_wakeups": 50, "branch": "cursor", "role": "Developer, front end first." },
    "codex":       { "aliases": ["api"], "branch": "codex", "role": "Developer, back end first." },
    "antigravity": { "aliases": ["gemini"], "branch": "antigravity", "role": "Developer, tooling and scripts first." }
  },
  "release": {
    "repo_dir": "C:/Projects/my-project/lead",
    "push_command": ["git", "push", "origin", "main"]
  }
}
